{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./lib/*"],
      "@generated/*": ["./generated/*"]
    }
  },
  "include": ["src/**/*", "lib/**/*.ts", "generated/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
