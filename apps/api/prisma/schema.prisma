// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int      @id @unique @default(autoincrement())
  username   String   @unique @db.VarChar(100)
  email      String   @unique
  password   String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profile    Profile?
  referredBy String?
  roleId     Int
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  userPoints      UserPoint[]
  promotionUsages PromotionUsage[]
  userPromotions  UserPromotion[]
  userAddresses   UserAddress[]
  carts           Cart[]
  orders          Order[]
}

model Role {
  id    Int    @id @unique
  role  String @unique
  users User[]
}

enum Gender {
  Men
  Women
  Other
}

model Profile {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  avatar    String?
  bio       String?   @db.VarChar(200)
  birthday  DateTime?
  gender    Gender?
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @updatedAt
}

enum AddressType {
  HOME
  OFFICE
}

model UserAddress {
  id        Int         @id @default(autoincrement())
  userId    Int
  name      String      @db.VarChar(100)
  phone     String      @db.VarChar(15)
  street    String      @db.VarChar(200)
  region    String      @db.VarChar(200)
  line      String      @db.VarChar(200)
  type      AddressType
  latitude  Float
  longitude Float
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("user_address")
}

enum PointType {
  REDEEM
  EARN
}

model UserPoint {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal   @db.Decimal(18, 2)
  type       PointType
  validUntil DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("user_point")
}

enum ProductStatus {
  ARCHIVE
  DRAFT
  ACTIVE
}

model Product {
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(200)
  slug              String             @unique
  sku               String             @unique
  brandId           Int
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  basePrice         Decimal            @db.Decimal(18, 2)
  status            ProductStatus      @default(ACTIVE)
  sizingGuideId     Int?
  sizingGuide       SizingGuide?       @relation(fields: [sizingGuideId], references: [id])
  productDetails    ProductDetails?
  productAttributes ProductAttribute[]
  productVariants   ProductVariant[]
  productCategories ProductCategory[]
  images            ProductImage[]
  productTags       ProductTag[]
  orderItems        OrderItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([brandId])
}

model Brand {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique
  image       String?  @db.VarChar(200)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  products Product[]
}

model ProductDetails {
  id          Int     @id @default(autoincrement())
  productId   Int     @unique
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  description String  @db.Text
  material    String?
  feature     String? @db.Text
  weight      Int
  length      Int?
  width       Int?
  height      Int?
  volume      Int?
  care        String? @db.Text

  @@map("product_details")
}

model SizingGuide {
  id        Int    @id @default(autoincrement())
  name      String
  guideData Json

  products Product[]

  @@map("sizing_guide")
}

model ProductImage {
  id               Int             @id @default(autoincrement())
  url              String
  productId        Int
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId Int?
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model Attribute {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique

  attributeValues   AttributeValue[]
  productAttributes ProductAttribute[]
}

model AttributeValue {
  id          Int     @id @default(autoincrement())
  attributeId Int
  value       String  @db.VarChar(100)
  slug        String  @unique
  hexUrl      String?

  attribute                Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productVariantAttributes ProductVariantAttribute[]
  productImages            ProductImage[]

  @@unique([attributeId, value])
  @@map("attribute_value")
}

model ProductAttribute {
  productId   Int
  attributeId Int
  imageBased  Boolean @default(false)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@map("product_attribute")
}

model ProductVariant {
  id                       Int                       @id @default(autoincrement())
  productId                Int
  sku                      String                    @unique
  barcode                  String?                   @unique
  basePrice                Decimal                   @db.Decimal(18, 2)
  stock                    Int
  reservedStock            Int                       @default(0)
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  productVariantAttributes ProductVariantAttribute[]
  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems                CartItem[]
  orderItems               OrderItem[]

  @@index([productId, stock])
  @@index([productId, basePrice])
  @@index([productId, isActive])
  @@map("product_variant")
}

model ProductVariantAttribute {
  productVariantId Int
  attributeValueId Int

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productVariantId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_variant_attribute")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  image       String?  @db.VarChar(200)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  categoryHierarchies CategoryHierarchy[]
}

model CategoryHierarchy {
  id                Int                 @id @default(autoincrement())
  parentId          Int?
  categoryId        Int
  level             Int // 1 = department, 2 collection, 3 = category, 4 = subcategory
  path              String              @db.VarChar(255)
  parent            CategoryHierarchy?  @relation("CategoryParent", fields: [parentId], references: [id])
  children          CategoryHierarchy[] @relation("CategoryParent")
  category          Category            @relation(fields: [categoryId], references: [id])
  productCategories ProductCategory[]

  @@index([parentId])
  @@index([path])
  @@map("category_hierarchy")
}

model ProductCategory {
  categoryHierarchyId Int
  categoryHierarchy   CategoryHierarchy @relation(fields: [categoryHierarchyId], references: [id])
  productId           Int
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryHierarchyId, productId])
  @@index([categoryHierarchyId])
  @@map("product_category")
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  slug        String       @unique
  productTags ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tag")
}

enum PromotionType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum PromotionApplyTo {
  ORDER
  PRODUCT
  CATEGORY
  BRAND
  TAG
}

model Promotion {
  id      Int              @id @default(autoincrement())
  name    String
  code    String?          @unique
  type    PromotionType
  value   Decimal          @db.Decimal(18, 2)
  applyTo PromotionApplyTo

  // Status and Behavior
  isStackable Boolean @default(false)
  // global “on/off” switch for the promotion.
  isActive    Boolean @default(true)
  // determines whether the user has to enter a code or it applies automatically.
  isAutomatic Boolean @default(false)

  promotionRule        PromotionRule?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  promotionUsages      PromotionUsage[]
  userPromotions       UserPromotion[]
  promotionAssignments PromotionAssignment[]
}

model PromotionRule {
  id                Int       @id @default(autoincrement())
  promotionId       Int       @unique
  minOrderValue     Decimal?  @db.Decimal(18, 2)
  maxDiscount       Decimal?  @db.Decimal(18, 2)
  usageLimit        Int?
  usageLimitPerUser Int?
  usedCount         Int       @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  firstOrderOnly    Boolean   @default(false)
  promotion         Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("promotion_rule")
}

enum AssignmentType {
  PRODUCT
  CATEGORY
  BRAND
  TAG
}

model PromotionAssignment {
  id          Int            @id @default(autoincrement())
  promotionId Int
  targetType  AssignmentType
  targetId    Int // references productId, categoryId, TagId or brandId

  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@map("promotion_assignment")
}

model PromotionUsage {
  id             Int      @id @default(autoincrement())
  promotionId    Int
  userId         Int
  orderId        Int
  usedAt         DateTime @default(now())
  promotionName  String
  promotionCode  String?
  discountAmount Decimal  @db.Decimal(18, 2)

  promotion Promotion @relation(fields: [promotionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([promotionId])
  @@index([userId])
  @@map("promotion_usage")
}

model UserPromotion {
  id          Int @id @default(autoincrement())
  userId      Int
  promotionId Int

  isUsed     Boolean   @default(false)
  assignedAt DateTime  @default(now())
  usedAt     DateTime?

  expiresAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([userId, promotionId])
  @@index([userId])
  @@map("user_promotion")
}

model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique
  sessionId String?   @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updateAt  DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([userId])
}

model CartItem {
  id               Int      @id @default(autoincrement())
  cartId           Int
  productVariantId Int
  quantity         Int
  unitPrice        Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updateAt         DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_item")
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id              Int              @id @default(autoincrement())
  orderNumber     String           @unique
  userId          Int
  status          OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus    @default(PENDING)
  subtotal        Decimal          @db.Decimal(18, 2)
  discountTotal   Decimal          @default(0) @db.Decimal(18, 2)
  pointsDiscount  Decimal          @default(0) @db.Decimal(18, 2)
  shippingFee     Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal          @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderAddress    OrderAddress?
  user            User             @relation(fields: [userId], references: [id])
  userAddressId   Int
  userAddress     UserAddress?     @relation(fields: [userAddressId], references: [id])
  orderItems      OrderItem[]
  promotionUsages PromotionUsage[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int
  productId        Int
  productVariantId Int
  productName      String
  sku              String
  variant          Json
  quantity         Int
  unitPrice        Decimal        @db.Decimal(18, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(18, 2)
  finalUnitPrice   Decimal        @db.Decimal(18, 2)
  totalPrice       Decimal        @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@map("order_item")
}

model OrderAddress {
  id        Int         @id @default(autoincrement())
  orderId   Int         @unique
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String      @db.VarChar(100)
  phone     String      @db.VarChar(15)
  street    String      @db.VarChar(200)
  region    String      @db.VarChar(200)
  line      String      @db.VarChar(200)
  type      AddressType
  latitude  Float
  longitude Float

  @@map("order_address")
}
